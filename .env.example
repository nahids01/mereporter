# Copy to .env.local. DO NOT commit real values. Only names are documented here.
# All values below are intentionally empty in this repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional, only if you enable the monthly cron route and email sending later:
RESEND_API_KEY=
SERP_API_KEY=
CRON_SECRET=
# DataForSEO (pay-as-you-go, user pays DataForSEO themselves — Muse must NOT
# subscribe or pay for you). Live SERP ranks + GBP grid only work when both are set.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional: PageSpeed Insights info for site audit (info only, never mixed into the audit score).
GOOGLE_PAGESPEED_API_KEY=
# Optional, only when email sending is wired up later: verified sender + recipients.
RESEND_FROM=
REPORT_RECIPIENTS=
# Live GSC/GA4 OAuth (owner creates the Google Cloud OAuth client; see Integrations page setup steps).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: dedicated HMAC secret for the OAuth state parameter. If unset, the server Supabase secret is used internally (never returned).
GOOGLE_OAUTH_STATE_SECRET=
# Bing Webmaster API key (Bing Webmaster Tools -> Settings -> API Access), server-side only.
BING_API_KEY=
